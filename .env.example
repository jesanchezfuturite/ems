# API del administrador. Por defecto apunta a producción; para QA usar https://hospital.futurite.info
PUBLIC_API_URL=https://administrador.especialidadesmedicassur.com.mx

# Token secreto (mínimo 32 caracteres) para revalidar páginas en caché (ISR).
# El backend lo envía como "Authorization: Bearer <token>" a POST /api/revalidate.
ISR_BYPASS_TOKEN=
